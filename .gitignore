# --- just mine notes ---
plan.md
result.md
bugs.md

# --- generated: full rebuild via `make world` ---
sysroot/
filesystem.img
disk.img
*.iso
iso_root/
build/
kernel/target/
host-tests/build/

# --- per-program build dirs (each Makefile builds into ./build) ---
user/*/build/
user/tests/*/build/

# --- ports build trees (regenerated by `make libs`) ---
ports/gnu/build/
ports/pixman/build-rbos/
ports/e2fsck/b/

# --- port sources fetched by `make -C ports fetch` (not vendored) ---
# release tarballs + unpacked trees; the tarball is the download cache
ports/gnu/binutils-*/
ports/gnu/*.tar.*
ports/e2fsck/e2fsprogs-*/
ports/e2fsck/*.tar.*

# NOTE: pixman/oksh/sbase/tcc are git submodules. Their build outputs are
# covered by the upstream .gitignores; remaining untracked build dirs
# (meson trees, generated configs) are hidden via `ignore = untracked`
# in .gitmodules so `git status` stays clean after a build.

# --- mlibc build outputs (regenerated by `make mlibc mlibc-dynamic`) ---
# Sources (sysdeps/rbos/*.c, include/, patches/) ARE committed; only the
# copied build artifacts below are ignored.
mlibc-sysdeps/sysdeps/rbos/lib/
mlibc-sysdeps/sysdeps/rbos/lib-dynamic/

# --- patch/merge leftovers ---
*.rej
*.orig

# --- in-source build output (rvi Makefile builds TARGET in place) ---
user/rvi/rvi
