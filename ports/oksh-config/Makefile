# This Makefile automatically generated by configure.

CC =		../rbos-cc
CFLAGS =	-DEMACS -DVI -std=gnu99

PREFIX =	../../sysroot/usr/
BINDIR =	../../sysroot/usr/bin
MANDIR =	../../sysroot/usr/share/man

PROG =	oksh
OBJS =	alloc.o c_ksh.o c_sh.o c_test.o c_ulimit.o edit.o \
	emacs.o eval.o exec.o expr.o history.o io.o jobs.o lex.o mail.o \
	main.o misc.o path.o shf.o syn.o table.o trap.o tree.o tty.o var.o \
	version.o vi.o siglist.o signame.o \
	strtonum.o unvis.o vis.o issetugid.o
# asprintf.o strlcat.o strlcpy.o reallocarray.o confstr.o was deleted FOR PORTING

all: ${PROG}

LDFLAGS?=	-dynamic

${PROG}: ${OBJS} ../../sysroot/usr/lib/libc.a
	${CC} ${LDFLAGS} -o ${PROG} ${OBJS}  ${LIBS}

install:
	install -d ${DESTDIR}${BINDIR}
	install -d ${DESTDIR}${MANDIR}/man1
	install -c -s -m 755 ${PROG} ${DESTDIR}${BINDIR}
	install -c -m 644 ${PROG}.1 ${DESTDIR}${MANDIR}/man1
	@echo "Please add /usr/local/bin/oksh to /etc/shells"

uninstall:
	rm -f ${DESTDIR}${BINDIR}/${PROG}
	rm -f ${DESTDIR}${MANDIR}/man1/${PROG}.1

test:
	echo "No tests"

clean:
	rm -f ${PROG} ${OBJS}

distclean: clean
	rm -f Makefile pconfig.h *.core
