# rbOS GNU binutils port wrapper.
#
# Release tarball, NOT vendored: `make fetch` downloads it (URL + sha256
# pinned below) and unpacks. The build tree (./build) is regenerated by
# `make setup`, so `rm -rf build` is always safe.
#
# binutils are cross-built (x86_64-unknown-linux-mlibc) into ./build using
# rbos-cc. This wrapper only builds whatever is missing and installs the
# complete set of tools (as, ld, objdump, ar, ...) into the sysroot with
# plain names.

SYSROOT := $(abspath ../../sysroot)
SRCDIR  := binutils-2.47
TARBALL := binutils-2.47.tar.zst
TARBALL_URL := https://ftp.gnu.org/gnu/binutils/binutils-2.47.tar.zst
TARBALL_SHA256 := 6b65d318b49c3b59c329ba712c3f4f0b0282269ce6dc5a2038a100aaf309059f
BUILD   := build
RBOS_CC := $(abspath ../../user/rbos-cc)
# Upstream binutils has no `uninstall`. The installed set is large and
# version-driven, so uninstall replays `make install` into a throwaway
# staging dir and removes the same relative paths from the sysroot.
# Always correct, no manifest state to go stale.
STAGE := $(abspath $(BUILD)/uninstall-stage)

# Exact configure line this tree was created with (see build/config.log).
# setup recreates it, so `rm -rf build` is always safe.
# AR/RANLIB are host tools on purpose: the binutils we build RUN on the
# build machine (only their output targets mlibc), so the target-prefixed
# `x86_64-unknown-linux-mlibc-ar` must not be used here.
CONFIGURE_FLAGS := --host=x86_64-unknown-linux-mlibc \
	--build=x86_64-pc-linux-gnu --target=x86_64-unknown-linux-mlibc \
	--disable-nls --disable-werror --disable-gold --disable-gprofng \
	--disable-gdb --disable-gprof --disable-shared --enable-static \
	--without-zlib --without-zstd --disable-plugins --with-debuginfod=no

.PHONY: all install uninstall clean setup fetch

# Download (once) + verify + unpack the release tarball.
fetch:
	@if [ ! -f "$(TARBALL)" ]; then \
		echo "binutils: downloading $(TARBALL_URL)"; \
		curl -fL -o $(TARBALL) $(TARBALL_URL); \
	fi
	@echo "$(TARBALL_SHA256)  $(TARBALL)" | sha256sum -c -
	@if [ ! -f "$(SRCDIR)/configure" ]; then \
		echo "binutils: unpacking $(TARBALL)"; \
		rm -rf $(SRCDIR); \
		zstd -d -c $(TARBALL) | tar -xf -; \
	fi

# libiberty bundles getopt/getopt1 "just in case", but our libc (mlibc:
# posix getopt + glibc getopt_long) already provides the whole family —
# linking both gives `multiple definition of getopt`. Drop the bundled
# fallback so there is a single provider. Idempotent: skips when applied.
setup: fetch
	@if [ -f "$(BUILD)/Makefile" ] && ! grep -qF "$(SRCDIR)" $(BUILD)/Makefile; then \
		echo "binutils: build tree is for another version, removing"; \
		rm -rf $(BUILD); \
	fi
	@if grep -qF './getopt.$$(objext) ./getopt1.$$(objext)' $(SRCDIR)/libiberty/Makefile.in; then \
		echo "binutils: dropping bundled getopt (mlibc provides it)"; \
		patch -d $(SRCDIR) -p1 --forward --batch \
			< patches/0001-libiberty-drop-bundled-getopt.patch; \
	fi
	@if grep -qF './getopt.$$(objext) ./getopt1.$$(objext)' $(SRCDIR)/libiberty/Makefile.in; then \
		echo "binutils: dropping bundled getopt (mlibc provides it)"; \
		patch -d $(SRCDIR) -p1 --forward --batch \
			< patches/0001-libiberty-drop-bundled-getopt.patch; \
	fi
	@if [ ! -f "$(BUILD)/Makefile" ]; then \
		echo "binutils: configuring build tree"; \
		mkdir -p $(BUILD); \
		cd $(BUILD) && CC="$(RBOS_CC)" AR="ar" RANLIB="ranlib" \
			../$(SRCDIR)/configure $(CONFIGURE_FLAGS); \
	else \
		echo "binutils: build tree already configured"; \
	fi

all: setup
	@echo "=== Building binutils (if needed) ==="
	@if [ ! -f "$(BUILD)/gas/as-new" ]; then \
		echo "binutils: build tree missing as-new, running make"; \
		$(MAKE) -C $(BUILD); \
	else \
		echo "binutils: already built"; \
	fi

install: all
	@echo "=== Installing binutils into sysroot ==="
	$(MAKE) -C $(BUILD) install DESTDIR=$(SYSROOT) prefix=/usr

uninstall:
	@echo "=== Uninstalling binutils from sysroot (via staging replay) ==="
	rm -rf $(STAGE)
	@$(MAKE) -C $(BUILD) install DESTDIR=$(STAGE) prefix=/usr > /dev/null
	cd $(STAGE) && find . -mindepth 1 \( -type f -o -type l \) | \
		sed 's|^\./||' | while read -r f; do rm -f "$(SYSROOT)/$$f"; done
	rm -rf $(STAGE)

clean:
	$(MAKE) -C $(BUILD) clean 2>/dev/null || true
