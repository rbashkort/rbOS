# rbOS e2fsck port wrapper.
#
# Release tarball, NOT vendored: `make fetch` downloads it (URL + sha256
# pinned below). The build tree (b/) and the unpacked sources are
# regenerated by ./build, so `rm -rf b e2fsprogs-*` is always safe.
#
# Builds a static e2fsck (e2fsprogs 1.47.2, fetched tarball) against the
# rbOS sysroot using bundled libuuid/libblkid. Installed to
# `/usr/bin/e2fsck` (stripped on install to save ~19MB of debug info).
# See README.md for the porting notes (rbos patches, sbrk shim, manual
# static link).

TARBALL := e2fsprogs-1.47.2.tar.gz
TARBALL_URL := https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v1.47.2/e2fsprogs-1.47.2.tar.gz
TARBALL_SHA256 := 7a959221c1b1cc6e28b7d7a4e204a2ffd8ec6d8a2de4461c482b64c5f4463cca

.PHONY: all install uninstall clean fetch

fetch:
	@if [ ! -f "$(TARBALL)" ]; then \
		echo "e2fsck: downloading $(TARBALL_URL)"; \
		curl -fL -o $(TARBALL) $(TARBALL_URL); \
	fi
	@echo "$(TARBALL_SHA256)  $(TARBALL)" | sha256sum -c -

all: fetch
	@echo "=== Building port: e2fsck ==="
	./build

install: all
	@echo "=== Installing e2fsck into sysroot ==="
	mkdir -p ../../sysroot/usr/bin
	cp b/e2fsck-static ../../sysroot/usr/bin/e2fsck
	chmod +x ../../sysroot/usr/bin/e2fsck
	strip ../../sysroot/usr/bin/e2fsck

uninstall:
	rm -f ../../sysroot/usr/bin/e2fsck

clean:
	rm -rf b e2fsprogs-1.47.2
